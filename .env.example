# App origin and Base RPC
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BASE_APP_URL=https://drawcoin.app
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Enable only for local/preview badge staging; keep false in main production.
NEXT_PUBLIC_ENABLE_BASE_SEPOLIA=true
ETHEREUM_RPC_URL=https://your-private-ethereum-mainnet-rpc.example

# Base Dashboard / ERC-8021 attribution
NEXT_PUBLIC_BUILDER_CODE=bc_your_builder_code
NEXT_PUBLIC_DRAWCOIN_PLATFORM_REFERRER=0xbFA6A45Dd534d39dF47A3F3D2f2b6E88416f9831
BASE_DASHBOARD_API_KEY=

# Supabase (service role must remain server-only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Server-only background jobs and upstream ingestion. Vercel Cron sends
# CRON_SECRET as a Bearer token automatically in production.
CRON_SECRET=replace-with-at-least-32-random-characters
ZORA_API_KEY=your-server-only-zora-api-key
PINATA_JWT=your-server-only-pinata-jwt
NEYNAR_API_KEY=your-optional-server-only-neynar-key

# SIWE cookie and nonce protection (at least 32 random characters)
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
# Non-Vercel only: set this solely when a trusted proxy overwrites the header
# and direct access to the app origin is blocked. Supported values:
# x-forwarded-for, x-real-ip, cf-connecting-ip
AUTH_TRUSTED_CLIENT_IP_HEADER=

# Mission badge contract; start on Base Sepolia (84532), then use 8453
BADGE_CONTRACT_CHAIN_ID=8453
BADGE_CONTRACT_ADDRESS=0x089E3889287E8c72892b42d1a856FA0AB51a0737
NEXT_PUBLIC_BADGE_CONTRACT_ADDRESS=0x089E3889287E8c72892b42d1a856FA0AB51a0737
BADGE_RPC_URL=https://mainnet.base.org
PRIVATE_KEY=0xYOUR_SERVER_ONLY_32_BYTE_PRIVATE_KEY
BADGE_CLAIM_VOUCHER_TTL_SECONDS=600

# ERC-7677 gas sponsorship is fail-closed. Leave disabled until the paymaster
# migration is applied and the upstream CDP policy is restricted exactly as
# documented. Never expose the provider URL in NEXT_PUBLIC_*.
PAYMASTER_PROXY_ENABLED=false
BASE_PAYMASTER_SERVICE_URL=https://api.developer.coinbase.com/rpc/v1/base-sepolia/YOUR_KEY
PAYMASTER_PROXY_SECRET=replace-with-an-independent-32-character-secret
